# Copy to .env and adjust as needed. Local mode (the defaults below) works
# with zero AWS credentials.

# --- Candidate search window ---
TIME_WINDOW_MINUTES=30
LOCATION_RADIUS_KM=1.0

# --- Match score weights (should sum to 1.0) ---
LOCATION_WEIGHT=0.35
TIME_WEIGHT=0.25
EVENT_WEIGHT=0.20
SEMANTIC_WEIGHT=0.20

# --- Decision thresholds ---
MERGE_THRESHOLD=0.75
UNCERTAIN_THRESHOLD=0.45

# --- Storage backend: "local" (default) or "dynamodb" ---
STORAGE_BACKEND=local

# --- Bedrock (optional, off by default) ---
USE_BEDROCK=false
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- AWS ---
AWS_REGION=us-east-1
DYNAMODB_REPORTS_TABLE=incidentpulse-reports
DYNAMODB_INCIDENTS_TABLE=incidentpulse-incidents

# Set to "true" to allow POST /reset to wipe a real DynamoDB table.
# Leave false/unset in any shared or production environment.
ALLOW_DYNAMODB_RESET=false

# Do NOT put real AWS access keys here or anywhere in the repo.
# Use IAM roles, `aws configure`, or environment variables injected by
# your deployment platform instead.
