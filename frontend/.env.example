# URL of the IncidentPulse backend. If unset, unreachable, or the
# initial health check fails, the app automatically falls back to
# DEMO MODE with realistic mock data.
VITE_API_URL=http://127.0.0.1:8000

# Polling interval for GET /incidents, in milliseconds. Default: 10000 (10s)
VITE_POLL_INTERVAL_MS=10000
